\@writefile{toc}{\contentsline {subsubsection}{\numberline {4.4.1}Monotone vs.\nobreakspace  {}Non-Monotone Weighting}{6}{subsubsection.4.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Spectral-adaptive MSE stratified by spectral regularity regime (high $\Omega > 0.7$, medium $0.4 \le \Omega \le 0.7$, low $\Omega < 0.4$). Largest gains occur in medium-regularity regime (51\% improvement: 0.242 vs.\nobreakspace  {}0.489 naive baseline) where neither pure linear nor pure nonlinear methods dominate, validating the core hypothesis that ensemble adaptation is most valuable in mixed-difficulty data.}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:regime_stratified}{{2}{7}{Spectral-adaptive MSE stratified by spectral regularity regime (high $\Omega > 0.7$, medium $0.4 \le \Omega \le 0.7$, low $\Omega < 0.4$). Largest gains occur in medium-regularity regime (51\% improvement: 0.242 vs.~0.489 naive baseline) where neither pure linear nor pure nonlinear methods dominate, validating the core hypothesis that ensemble adaptation is most valuable in mixed-difficulty data}{figure.2}{}}
